# --- Auth / session ---
SESSION_SECRET=change-me-to-a-long-random-string
# When unset, OTP codes are logged to the server console and returned in the API (dev only).
RESEND_API_KEY=
EMAIL_FROM=PassATS <onboarding@resend.dev>
APP_BASE_URL=http://localhost:3000
# Local Pro without Creem. Set to 1 in .dev.vars for history / unlimited testing.
# Leave unset/0 in production so webhook-driven subscriptions gate Pro.
DEV_PREMIUM=1

# --- Creem billing ---
# Dashboard: https://creem.io — use Test Mode keys until you are ready to charge.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# Product IDs from Creem (prod_…) for $12/mo and $79/yr recurring products.
CREEM_PRICE_MONTHLY=
CREEM_PRICE_YEARLY=
# Optional: https://test-api.creem.io for Test Mode API (default https://api.creem.io).
CREEM_API_BASE=
# Success redirect after checkout (default: {APP_BASE_URL}/account?upgraded=1).
CREEM_SUCCESS_URL=
# Fallback if API checkout is unavailable: paste Creem product/checkout page URLs.
CREEM_CHECKOUT_URL_MONTHLY=
CREEM_CHECKOUT_URL_YEARLY=
NEXT_PUBLIC_CREEM_CHECKOUT_URL=
CREEM_CUSTOMER_PORTAL_URL=
